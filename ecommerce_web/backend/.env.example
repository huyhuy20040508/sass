APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_web
DB_USERNAME=ecommerce_web
DB_PASSWORD=

# Gốc tên miền của web: mỗi shop có địa chỉ <mã>.<gốc>. Dev: huyweb.selliotech.store,
# prod: web.selliotech.store (prod tự sinh .env — deploy/scripts/05-web-ban.sh).
# Cần bản ghi DNS *.<gốc> trỏ về máy chủ và chứng chỉ phủ các địa chỉ đó.
WEB_BASE_DOMAIN=huyweb.selliotech.store

# Khoá mã hoá token POS lưu trong DB. Sinh: php -r 'echo base64_encode(random_bytes(32)), "\n";'
APP_KEY=

# API POS — admin web đăng nhập bằng tài khoản POS. Gọi từ trong máy chủ.
POS_API_URL=http://127.0.0.1:8091/api/v1
