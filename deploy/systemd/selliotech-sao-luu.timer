# Sao lưu mỗi nửa ngày.
#
# Đặt tại: /etc/systemd/system/selliotech-sao-luu.timer
# Bật:     systemctl enable --now selliotech-sao-luu.timer
# Kiểm:    systemctl list-timers selliotech-sao-luu.timer

[Unit]
Description=Sao lưu Selliotech mỗi 12 giờ

[Timer]
# Giờ MÁY CHỦ. VPS này đặt Asia/Bangkok (+07), cùng lệch với giờ Việt Nam và
# không có giờ mùa hè — nên 03:00 và 15:00 ở đây đúng là 3 giờ sáng và 3 giờ
# chiều giờ ta. Đừng suy ra từ chỗ khác: kiểm bằng `timedatectl`, vì cùng một
# dòng OnCalendar rơi vào giờ nào là do múi giờ máy quyết định.
OnCalendar=*-*-* 03,15:00:00

# Máy chủ tắt hoặc khởi động lại đúng lúc tới giờ thì chạy bù ngay khi lên.
# Thiếu dòng này, một lần reboot đúng 03:00 là mất trắng nửa ngày dữ liệu mà
# không có gì báo — kiểu hụt lịch không ai để ý cho tới lúc cần phục hồi.
Persistent=true

# Lệch ngẫu nhiên tối đa 5 phút. Máy chủ này chạy chung với dự án khác; mọi
# tác vụ nặng cùng nổ đúng giây 00:00 là lúc đĩa nghẽn nhất.
RandomizedDelaySec=300
AccuracySec=1min

Unit=selliotech-sao-luu.service

[Install]
WantedBy=timers.target
