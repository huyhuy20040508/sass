# =====================================================================
#  admin/.env  cho MÁY CHỦ THẬT — Shop Admin (khu quản lý bán hàng)
#
#  Chép thành /var/www/selliotech/admin/.env rồi chạy:
#      php artisan key:generate
# =====================================================================

APP_NAME="Selliotech Admin"
APP_ENV=production
APP_KEY=
# BẮT BUỘC false. Để true là mỗi lỗi 500 phơi ra nguyên stack trace kèm biến
# môi trường — trong đó có mật khẩu database và khoá JWT.
APP_DEBUG=false
APP_URL=https://admin.selliotech.store

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ===== Phiên =====
# App này KHÔNG nối MySQL — session và cache đều nằm ở tệp.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Để null: cookie tự bó vào đúng admin.selliotech.store. Điền ".selliotech.store"
# là cookie lan sang mọi subdomain, tức phiên của Shop Admin có mặt trong mọi
# request gửi tới khu điều hành nền tảng.
SESSION_DOMAIN=null
# Tên riêng, khác SaaS Admin.
SESSION_COOKIE=selliotech_admin_session
# Chạy sau HTTPS nên chỉ gửi cookie qua kết nối mã hoá.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=selliotech_admin

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@selliotech.store"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Go API =====
# Hai giá trị KHÁC NHAU và cả hai đều cần:
#
#   API_BASE_URL   — PHP gọi từ trong máy chủ. Đi thẳng 127.0.0.1 để khỏi vòng
#                    ra ngoài rồi quay lại qua nginx + TLS cho mỗi lượt gọi.
#   API_PUBLIC_URL — TRÌNH DUYỆT gọi, dùng cho luồng realtime (SSE). Trình duyệt
#                    của khách không với tới 127.0.0.1 của máy chủ, nên chỗ này
#                    bắt buộc là tên miền công khai.
API_BASE_URL=http://127.0.0.1:8080/api/v1
API_PUBLIC_URL=https://api.selliotech.store/api/v1
API_TIMEOUT=15

# Tài khoản cho smoke test — để trống trên máy thật.
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
