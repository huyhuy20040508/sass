# =====================================================================
#  api/.env  cho MÁY CHỦ THẬT  (khác hẳn bản .env.example dùng ở máy cá nhân)
#
#  Chép thành /var/www/selliotech/api/.env rồi điền hai chỗ <...>.
#  Tệp này chứa mật khẩu database và khoá ký token — chmod 600, không commit.
# =====================================================================

APP_NAME=Selliotech API
APP_ENV=production
APP_PORT=8090

# Swagger đọc giá trị này để trỏ "Try it out" về đúng máy chủ. Sai ở đây thì
# trang /swagger vẫn bắn request về localhost:8080 và không ai gọi thử được.
APP_BASE_URL=https://api.selliotech.store

# Nền tảng chưa bán hàng cho khách lẻ — cụm route storefront vẫn tắt.
STOREFRONT_API_ENABLED=false

# Chỉ tin nginx cùng máy khai hộ địa chỉ khách. KHÔNG thêm địa chỉ nào khác:
# mọi hạn mức tính theo IP bị vượt qua chỉ bằng cách đổi header X-Forwarded-For
# nếu danh sách này rộng tay.
TRUSTED_PROXIES=127.0.0.1,::1

# ===== Database =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=selliotech
DB_PASSWORD=<MAT_KHAU_DATABASE>
DB_NAME=selliotech
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=60s

# ===== JWT =====
# BẮT BUỘC sinh mới, đừng bê chuỗi ở máy cá nhân lên:
#     openssl rand -base64 48
JWT_SECRET=<SINH_BANG_openssl_rand_base64_48>

# 15 phút, KHÔNG phải 268h như bản chạy máy cá nhân. Con số dài ở đó là để khỏi
# phải đăng nhập lại khi đang sửa code; trên máy thật nó có nghĩa là token bị
# lộ vẫn dùng được suốt 11 ngày. Cả hai khu quản trị đều tự gọi /auth/refresh
# khi gặp 401 nên người dùng không thấy khác biệt gì.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ===== CORS =====
# Đúng hai khu quản trị, ghi đủ https:// và không có dấu / ở cuối.
CORS_ALLOW_ORIGINS=https://order.selliotech.store,https://admin.selliotech.store

# ===== Hạn mức gọi theo IP =====
# Trên máy thật LUÔN bật. Tắt chỉ dành cho máy cá nhân, nơi mọi lượt gọi cùng
# mang IP 127.0.0.1 nên dùng chung một hạn mức.
RATE_LIMIT_ENABLED=true

# ===== Email (tuỳ chọn) =====
# Bỏ trống = không gửi thư thật; hệ thống vẫn chạy, chỉ là khách không nhận
# được thư xác nhận đơn. Với Gmail phải dùng "mật khẩu ứng dụng" 16 ký tự,
# không phải mật khẩu đăng nhập.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Selliotech
MAIL_FROM_ADDRESS=
MAIL_STORE_URL=https://selliotech.store

# ===== Cổng thanh toán (tuỳ chọn) =====
# Thiếu khoá thì hình thức thanh toán tương ứng tự ẩn khỏi giao diện.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
