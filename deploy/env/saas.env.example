# =====================================================================
#  saas/.env  cho MÁY CHỦ THẬT — SaaS Admin (khu điều hành nền tảng)
#
#  Chép thành /var/www/selliotech/saas/.env rồi chạy:
#      php artisan key:generate
# =====================================================================

APP_NAME="Selliotech SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.selliotech.store

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ===== Phiên =====
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Tên riêng, khác Shop Admin — xem ghi chú ở admin.env.example.
SESSION_COOKIE=selliotech_saas_session
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=selliotech_saas

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@selliotech.store"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Go API =====
# Khu điều hành hiện chỉ gọi /auth/* và /health từ phía PHP, chưa có gì chạy ở
# trình duyệt, nên API_PUBLIC_URL chưa dùng tới. Vẫn khai sẵn để khi thêm màn
# hình có realtime thì không phải đi tìm lý do vì sao SSE không nối được.
API_BASE_URL=http://127.0.0.1:8090/api/v1
API_PUBLIC_URL=https://api.selliotech.store/api/v1
API_TIMEOUT=15
