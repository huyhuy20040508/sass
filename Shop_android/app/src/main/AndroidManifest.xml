<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- required=false: máy không có camera vẫn cài được, chỉ mất màn quét. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Selliotech">

        <!-- Bảo Play Services tải sẵn bộ đọc mã vạch lúc cài, để lần quét đầu
             tiên không phải chờ tải giữa lúc đang bán hàng. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <!-- Chia tệp CSV ra ngoài (Zalo, Drive, Gmail...) mà không cần quyền
             ghi bộ nhớ: FileProvider cấp quyền đọc TẠM cho đúng một tệp, đúng
             một app nhận, và quyền ấy hết hiệu lực khi người dùng rời đi.

             Xin quyền ghi bộ nhớ ngoài thì được y hệt nhưng đổi lại app đọc
             ghi được cả kho ảnh của người ta — đòi quá tay cho một việc xuất
             tệp. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.tep"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/duong_tep_chia_se" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Selliotech">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
