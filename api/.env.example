# ===== App =====
APP_NAME=Sass API
# Phần mềm mà tiến trình API này phục vụ, khớp apps.code bên control plane.
# Quyết định tên miền nào phân giải được: sổ tên miền có cả địa chỉ của các
# phần mềm khác, và tiến trình này chỉ nhận địa chỉ của chính nó.
APP_CODE=order
APP_ENV=development          # development | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Bat/tat CA CUM route ban hang cho khach (dat hang, gio hang, tra cuu don,
# webhook thanh toan, form lien he...). Du an nay chi co khu quan tri nen de
# false. Doi thanh true la co lai day du, code van con nguyen trong handler.
# Xem internal/router/router.go.
STOREFRONT_API_ENABLED=false

# ===== Database (MySQL 8) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=selliotech
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
# Phải nhỏ hơn wait_timeout cua MySQL (XAMPP mac dinh 180s)
DB_CONN_MAX_IDLE_TIME=60s

# ===== Control plane (database THU HAI) =====
# So cai cua nen tang: khach hang, thue bao, tai khoan khu dieu hanh, ten mien.
# Database RIENG, khong phai vai bang them vao database ban hang — xem
# database/platform/. Trung ten voi DB_NAME thi API tu choi khoi dong.
#
# Dung ngay lan dau (tu tao database neu chua co):
#     cd api && go run ./cmd/migrate -nen-tang chay
PLATFORM_DB_NAME=selliotech_platform
# Bo trong = dung lai host/cong/tai khoan cua DB_* o tren (hai luoc do dang nam
# cung mot may chu MySQL). Chi khai khi tach may chu, hoac khi muon tai khoan
# MySQL rieng cho so nen tang.
PLATFORM_DB_HOST=
PLATFORM_DB_PORT=
PLATFORM_DB_USER=
PLATFORM_DB_PASSWORD=
# Pool nho: khu dieu hanh chi co vai nguoi dung, khong phai luong ban hang.
PLATFORM_DB_MAX_OPEN_CONNS=10
PLATFORM_DB_MAX_IDLE_CONNS=2

# ===== JWT =====
JWT_SECRET=doi-secret-nay-truoc-khi-deploy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ===== CORS =====
CORS_ALLOW_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# ===== PayOS (cong thanh toan QR - payos.vn) =====
# Lay o trang quan ly PayOS: Kenh thanh toan -> Thong tin ket noi.
# Thieu bat ky khoa nao thi hinh thuc "Thanh toan online" tu dong an di.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
# Trang cua STOREFRONT ma PayOS dua khach quay ve sau khi tra tien / bam huy
PAYOS_RETURN_URL=http://localhost:8000/thanh-toan/ket-qua
PAYOS_CANCEL_URL=http://localhost:8000/thanh-toan/ket-qua
# Han cua mot link thanh toan
PAYOS_EXPIRE=30m

# ===== SePay (doi soat chuyen khoan tu dong - sepay.vn) =====
# Khac PayOS: SePay doc bien dong so du tai khoan ngan hang cua ban roi ban webhook ve.
# Doi soat theo NOI DUNG chuyen khoan (khach chuyen kem ma don).
# Lay o my.sepay.vn: Tai khoan ngan hang -> so tai khoan da lien ket; Webhooks -> API Key.
SEPAY_ACCOUNT_NUMBER=
# Ma ngan hang ngan gon theo SePay: MBBank | Vietcombank | TPBank | ACB | Techcombank | BIDV ...
SEPAY_BANK=
SEPAY_ACCOUNT_NAME=
# Phai co IT NHAT MOT trong hai khoa duoi day thi moi biet duoc khach da tra tien:
#   - WEBHOOK_API_KEY: SePay chu dong bao sang (can may chu co dia chi cong khai)
#   - API_TOKEN:       minh chu dong do sao ke (chay duoc ca o may local)
# Khoa SePay gan vao header "Authorization: Apikey <khoa>" cua moi webhook.
# Bo trong = KHONG nhan webhook (moi goi bi tu choi).
SEPAY_WEBHOOK_API_KEY=
# Token API tra cuu giao dich (my.sepay.vn -> API Access).
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://my.sepay.vn
SEPAY_QR_BASE_URL=https://qr.sepay.vn

# ===== Facebook Login (developers.facebook.com -> App -> Cai dat co ban) =====
# App secret CHI backend giu: no la thu doi `code` lay token cua khach.
# Bo trong = tat dang nhap Facebook (storefront tu an nut di).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_VERSION=v21.0

# ===== Google Sign-In (console.cloud.google.com -> API & Services -> Credentials) =====
# Client secret CHI backend giu, cung ly le voi Facebook.
# Bo trong = tat dang nhap Google (storefront tu an nut di).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Khoá mã hoá các giá trị bí mật cất trong platform_settings (khoá cổng thanh
# toán của nền tảng). Rỗng = màn hình Cài đặt của khu điều hành từ chối lưu mấy
# ô đó. Đổi khoá này thì các giá trị đã mã hoá trước đó KHÔNG giải được nữa —
# phải khai lại chúng.
PLATFORM_SECRET_KEY=

# Khoá mã hoá MẬT KHẨU CỔNG HOÁ ĐƠN ĐIỆN TỬ của từng cửa hàng (Cài đặt → Quản lý
# chi nhánh → Kết nối HĐĐT). Rỗng = API từ chối lưu lượt kết nối kèm lý do, chứ
# không ghi mật khẩu nguyên văn. Đổi khoá này thì các kết nối đã lưu KHÔNG đăng
# nhập lại được — phải khai lại mật khẩu.
ETAX_SECRET_KEY=

# Gốc địa chỉ Shop Admin — cổng thanh toán đưa khách quay về đây sau khi trả
# tiền gia hạn. Máy chủ tự dựng returnUrl từ giá trị này (KHÔNG nhận từ client:
# để client tự khai địa chỉ quay về là mở một đường chuyển hướng sang bất cứ đâu).
SHOP_ADMIN_URL=http://localhost:8001
