APP_NAME="Selliotech SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Database =====
# App nay KHONG ket noi DB truc tiep — moi du lieu di qua Go API.
# Session/Cache dung file driver nen khong can DB.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Ten cookie phien PHAI khac Shop Admin. Hai app cung chay tren localhost nen
# trinh duyet phan biet chung bang TEN cookie, khong phai bang cong. Trung ten
# la dang nhap ben nay da ben kia ra.
SESSION_COOKIE=selliotech_saas_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=selliotech_saas

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@selliotech.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Go API =====
# Nen tang va cua hang dung CHUNG mot API. Khu dieu hanh chi khac o cho no goi
# nhom /platform/* (chua co) va chi cho super_admin dang nhap.
API_BASE_URL=http://localhost:8080/api/v1
API_TIMEOUT=15
