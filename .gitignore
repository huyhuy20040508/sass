# ===== Chung =====
.DS_Store
Thumbs.db
*.log
*.tmp
~$*
.idea/
.vscode/
*.swp

# Bí mật: mật khẩu DB, khoá JWT, khoá cổng thanh toán, APP_KEY của Laravel.
# Chặn cả .env.local, .env.prod, .env.bak — chỉ chừa .env.example.
.env
.env.*
!.env.example

# ===== Go (api) =====
/api/bin/
/api/tmp/
/api/*.exe
/api/vendor/
/api/coverage.out
# Binary Linux build thẳng trên máy chủ
/api/api
/api/api.new

# ===== Laravel (web_Shop) =====
/web_Shop/vendor/
/web_Shop/storage/*.key
/web_Shop/storage/app/**
!/web_Shop/storage/app/.gitignore
/web_Shop/storage/debugbar/*
/web_Shop/storage/framework/cache/*
/web_Shop/storage/framework/sessions/*
/web_Shop/storage/framework/views/*
/web_Shop/storage/logs/*
/web_Shop/bootstrap/cache/*
/web_Shop/.phpunit.result.cache

# ===== Laravel (admin-Selliotech — khu điều hành nền tảng) =====
/admin-Selliotech/vendor/
/admin-Selliotech/storage/*.key
/admin-Selliotech/storage/app/**
!/admin-Selliotech/storage/app/.gitignore
/admin-Selliotech/storage/framework/cache/*
/admin-Selliotech/storage/framework/sessions/*
/admin-Selliotech/storage/framework/views/*
/admin-Selliotech/storage/logs/*
/admin-Selliotech/bootstrap/cache/*
/admin-Selliotech/.phpunit.result.cache

# Tài liệu .docx là KẾT QUẢ của sass-docx/tao-tai-lieu.py — chạy lại là có,
# không giữ bản nhị phân trong git (mỗi lần sinh lại là một tệp khác hoàn toàn).
/sass-docx/*.docx
/sass-docx/~$*
