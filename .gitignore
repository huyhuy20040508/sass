# ===== Chung =====
.DS_Store
Thumbs.db
*.log
*.tmp
~$*
.idea/
.vscode/
*.swp

# Bí mật: mật khẩu DB, khoá JWT, khoá cổng thanh toán, APP_KEY của Laravel.
# Chặn cả .env.local, .env.prod, .env.bak — chỉ chừa .env.example.
.env
.env.*
!.env.example

# ===== Go (api) =====
/api/bin/
/api/tmp/
/api/*.exe
/api/vendor/
/api/coverage.out
# Binary Linux build thẳng trên máy chủ
/api/api
/api/api.new

# ===== Laravel (admin) =====
/admin/vendor/
/admin/storage/*.key
/admin/storage/app/**
!/admin/storage/app/.gitignore
/admin/storage/debugbar/*
/admin/storage/framework/cache/*
/admin/storage/framework/sessions/*
/admin/storage/framework/views/*
/admin/storage/logs/*
/admin/bootstrap/cache/*
/admin/.phpunit.result.cache

# ===== Laravel (saas — khu điều hành nền tảng) =====
/saas/vendor/
/saas/storage/*.key
/saas/storage/app/**
!/saas/storage/app/.gitignore
/saas/storage/framework/cache/*
/saas/storage/framework/sessions/*
/saas/storage/framework/views/*
/saas/storage/logs/*
/saas/bootstrap/cache/*
/saas/.phpunit.result.cache

# Tài liệu .docx là KẾT QUẢ của sass-docx/tao-tai-lieu.py — chạy lại là có,
# không giữ bản nhị phân trong git (mỗi lần sinh lại là một tệp khác hoàn toàn).
/sass-docx/*.docx
/sass-docx/~$*
